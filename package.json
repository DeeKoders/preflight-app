{
  "name": "preflight",
  "private": true,
  "version": "1.0.0",
  "description": "Preflight — agentic AI development planning for Jira tickets",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "dev": "node scripts/dev.js",
    "dev:server": "npm run dev -w server",
    "dev:worker": "npm run worker:dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "npm test -w server && npm test -w client",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "setup": "node scripts/setup-env.js"
  },
  "engines": {
    "node": ">=20.19"
  }
}
