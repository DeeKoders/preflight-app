# ---------------------------------------------------------------------------
# Preflight configuration. Copy to `.env` (repo root) and adjust.
# Never commit your real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_NAME=Preflight
PORT=4000
# Comma-separated list of browser origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind a reverse proxy (needed for correct client IPs / secure cookies).
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database (docker compose exposes Postgres on 5433) ---------------------
DATABASE_URL=postgres://preflight:preflight@localhost:5433/preflight
TEST_DATABASE_URL=postgres://preflight:preflight@localhost:5433/preflight_test
DATABASE_SSL=false

# --- Redis / BullMQ (docker compose exposes Redis on 6380) ------------------
REDIS_URL=redis://localhost:6380
# Run the planning worker inside the API process (simple local setup).
# Set to false in production and run `npm run worker -w server` separately.
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2

# --- Security -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=12h
# 32-byte master key for AES-256-GCM credential encryption (base64 or 64 hex chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Send cookies with the Secure flag (enable in production over HTTPS).
COOKIE_SECURE=false

# --- Integrations -------------------------------------------------------------
# Jira Cloud hosts the server is allowed to call (SSRF protection).
JIRA_ALLOWED_HOST_SUFFIXES=.atlassian.net,.jira.com
GITHUB_API_URL=https://api.github.com

# --- Agent limits (protect against runaway execution & costs) ----------------
AGENT_MAX_ITERATIONS=14
AGENT_MAX_TOOL_CALLS=30
AGENT_TIMEOUT_MS=600000
AGENT_MAX_TOTAL_TOKENS=800000
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_PLAN_REPAIRS=2
PLANNING_JOB_ATTEMPTS=3
